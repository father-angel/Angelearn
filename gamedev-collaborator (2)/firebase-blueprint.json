{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private authenticated player account linked to Google/Gmail with full-body avatar and garden progress.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Gmail address of the player",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Player display name in AngelLearn",
          "minLength": 1,
          "maxLength": 50
        },
        "photoURL": {
          "type": "string",
          "description": "Google profile photo URL",
          "minLength": 0,
          "maxLength": 500
        },
        "gender": {
          "type": "string",
          "enum": ["boy", "girl"],
          "minLength": 3,
          "maxLength": 10
        },
        "coins": {
          "type": "number",
          "description": "Current gold coins balance"
        },
        "streakDays": {
          "type": "number",
          "description": "Consecutive active days streak"
        },
        "bio": {
          "type": "string",
          "description": "Player short biography",
          "minLength": 0,
          "maxLength": 140
        },
        "skinTone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "hairStyle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "hairColor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "faceExpression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "outfit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "pants": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "accessory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "bgAura": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "groupId": {
          "type": "string",
          "description": "Current active group ID if member",
          "minLength": 0,
          "maxLength": 128
        },
        "groupName": {
          "type": "string",
          "description": "Current active group display name",
          "minLength": 0,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was last updated"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "gender",
        "coins",
        "streakDays",
        "bio",
        "skinTone",
        "hairStyle",
        "hairColor",
        "faceExpression",
        "outfit",
        "pants",
        "accessory",
        "bgAura",
        "createdAt",
        "updatedAt"
      ]
    },
