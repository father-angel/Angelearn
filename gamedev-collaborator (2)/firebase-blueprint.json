    "DmThread": {
      "title": "DmThread",
      "description": "1-on-1 direct message thread metadata strictly isolated to its 2 participants.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
